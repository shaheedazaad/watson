#!/bin/sh
set -eu
if [ "$(uname -s)" = "Darwin" ]; then
  INSTALL_ROOT="$HOME/Library/Application Support/Watson/app"
else
  INSTALL_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/watson-app"
fi
if command -v pixi >/dev/null 2>&1; then
  PIXI="pixi"
elif [ -x "$HOME/.pixi/bin/pixi" ]; then
  PIXI="$HOME/.pixi/bin/pixi"
else
  printf 'Watson could not find Pixi. Re-run the Watson installer.\n' >&2
  exit 1
fi
exec "$PIXI" run --manifest-path "$INSTALL_ROOT/pixi.toml" watson "$@"
